# Aprimo tenant subdomain (e.g. "mycompany" for mycompany.dam.aprimo.com)
# Used as server fallback when clients do not send X-Aprimo-* headers
APRIMO_TENANT=your-tenant

# OAuth 2.0 Client Credentials registration from Aprimo Administration > Integration > Registrations
APRIMO_CLIENT_ID=your-client-id
APRIMO_CLIENT_SECRET=your-client-secret

# Client-side env vars for mcp-remote (see docs/client-configuration.md)
# APRIMO_ENVIRONMENT=your-tenant

# MCP server port (default: 3000)
PORT=3000

# Required for Azure App Service (Web App) — tells App Service which port the container uses
# WEBSITES_PORT=3000

# Optional: comma-separated allowed Origin values for /mcp (DNS rebinding protection)
# ALLOWED_ORIGINS=https://claude.ai,https://api.anthropic.com
